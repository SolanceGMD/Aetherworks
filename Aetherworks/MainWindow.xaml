<Window x:Class="Aetherworks.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aetherworks" Height="760" Width="1180" MinHeight="620" MinWidth="900" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#151A25" Padding="20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="AETHERWORKS" FontSize="21" FontWeight="Bold" Foreground="White" Margin="0,8,0,34"/>
          <Button Content="Home" Tag="Home" Click="Navigate_Click" Margin="0,3" HorizontalContentAlignment="Left"/>
          <Button Content="All Games" Tag="All Games" Click="Navigate_Click" Margin="0,3" HorizontalContentAlignment="Left"/>
          <Button Content="Library" Tag="Library" Click="Navigate_Click" Margin="0,3" HorizontalContentAlignment="Left"/>
          <Button Content="Downloads" Tag="Downloads" Click="Navigate_Click" Margin="0,3" HorizontalContentAlignment="Left"/>
          <Button Content="Settings" Tag="Settings" Click="Navigate_Click" Margin="0,3" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Aetherworks • 0.1.0" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,18"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,24">
        <TextBlock x:Name="PageTitle" Text="Discover games" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Content="↻ Refresh catalogue" DockPanel.Dock="Right" Click="Refresh_Click" Background="{StaticResource AccentBrush}"/>
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,22">
        <StackPanel>
          <TextBlock Text="Your games, in one place." FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="Browse your catalogue, install complete game depots, and launch directly from your library." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="Catalogue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox" Width="240" Margin="10,0,0,0" HorizontalAlignment="Right" TextChanged="Search_TextChanged"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="GamesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                      <ProgressBar Height="5" Width="260" HorizontalAlignment="Left" Value="{Binding Progress}" Maximum="100" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Content="Install" Tag="{Binding}" Click="Install_Click" Background="{StaticResource AccentBrush}" Margin="4"/>
                      <Button Content="Play" Tag="{Binding}" Click="Play_Click" Margin="4"/>
                      <Button Content="Uninstall" Tag="{Binding}" Click="Uninstall_Click" Margin="4"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <TextBlock x:Name="FooterStatus" Grid.Row="3" Text="Ready" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
    </Grid>
  </Grid>
</Window>